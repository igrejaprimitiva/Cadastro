<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cadastro de Ministérios Evangélicos</title>
  <meta name="description" content="Página de cadastro para coleta de informações de ministérios evangélicos." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg: #f6f1e7;
      --bg-soft: #fbf7ef;
      --surface: rgba(255,255,255,.62);
      --surface-strong: rgba(255,255,255,.78);
      --ink: #2a2118;
      --muted: #6d5a49;
      --gold: #b48a3c;
      --gold-deep: #8c6423;
      --olive: #53624b;
      --line: rgba(78, 57, 31, .14);
      --shadow: 0 20px 60px rgba(72, 48, 18, 0.10);
      --radius: 24px;
      --radius-sm: 14px;
      --max: 1180px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:"Manrope", sans-serif;
      color:var(--ink);
      background:
        radial-gradient(circle at top left, rgba(180,138,60,.14), transparent 28%),
        radial-gradient(circle at right 20%, rgba(83,98,75,.12), transparent 22%),
        linear-gradient(180deg, #f9f4ea 0%, #f3ede3 100%);
      min-height:100vh;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.28;
      background-image:
        linear-gradient(rgba(42,33,24,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(42,33,24,.03) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(circle at center, black 55%, transparent 100%);
    }

    .wrap{
      width:min(calc(100% - 32px), var(--max));
      margin-inline:auto;
    }

    .reveal{
      opacity:0;
      transform:translateY(26px);
      transition:opacity .8s ease, transform .8s ease;
    }

    .reveal.visible{
      opacity:1;
      transform:translateY(0);
    }

    .stagger-1{transition-delay:.08s}
    .stagger-2{transition-delay:.18s}
    .stagger-3{transition-delay:.28s}
    .stagger-4{transition-delay:.38s}

    header{
      padding:18px 0;
      position:sticky;
      top:0;
      z-index:30;
      backdrop-filter: blur(14px);
      background:linear-gradient(180deg, rgba(249,244,234,.84), rgba(249,244,234,.46));
      border-bottom:1px solid rgba(78, 57, 31, .08);
    }

    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:14px;
      text-decoration:none;
      color:var(--ink);
    }

    .brand-mark{
      width:46px;
      height:46px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:
        radial-gradient(circle at 30% 30%, #d7bc7a, #a4762e 70%);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 10px 24px rgba(122, 88, 30, .18);
      position:relative;
      overflow:hidden;
    }

    .brand-mark svg{
      width:24px;
      height:24px;
      fill:#fff8ec;
    }

    .brand-text strong{
      display:block;
      font-family:"Cinzel", serif;
      font-size:.95rem;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    .brand-text span{
      display:block;
      font-size:.82rem;
      color:var(--muted);
    }

    .nav-links{
      display:none;
      gap:22px;
    }

    .nav-links a{
      color:var(--muted);
      text-decoration:none;
      font-weight:600;
      position:relative;
    }

    .nav-links a::after{
      content:"";
      position:absolute;
      left:0;
      bottom:-6px;
      width:100%;
      height:2px;
      transform:scaleX(0);
      transform-origin:left;
      transition:transform .25s ease;
      background:linear-gradient(90deg, var(--gold), transparent);
    }

    .nav-links a:hover::after{transform:scaleX(1)}

    .hero{
      padding:58px 0 34px;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1fr;
      gap:22px;
      align-items:stretch;
    }

    .hero-copy,
    .hero-side,
    .form-shell{
      background:var(--surface);
      border:1px solid rgba(255,255,255,.5);
      box-shadow:var(--shadow);
      border-radius:var(--radius);
      backdrop-filter: blur(14px);
    }

    .hero-copy{
      padding:30px 24px;
      position:relative;
      overflow:hidden;
    }

    .hero-copy::before{
      content:"";
      position:absolute;
      inset:auto -40px -40px auto;
      width:180px;
      height:180px;
      border-radius:50%;
      background:radial-gradient(circle, rgba(180,138,60,.22), transparent 70%);
    }

    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:10px;
      font-size:.82rem;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:var(--gold-deep);
      font-weight:800;
      margin-bottom:14px;
    }

    .eyebrow::before{
      content:"";
      width:34px;
      height:1px;
      background:linear-gradient(90deg, var(--gold), transparent);
    }

    h1,h2,h3{
      margin:0;
      font-family:"Cinzel", serif;
      line-height:.95;
      color:#231a12;
    }

    h1{
      font-size:clamp(2.5rem, 7vw, 5.6rem);
      letter-spacing:-.03em;
      max-width:10ch;
    }

    .lead{
      margin:18px 0 0;
      color:var(--muted);
      font-size:1.03rem;
      line-height:1.75;
      max-width:62ch;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:26px;
    }

    .btn{
      appearance:none;
      border:none;
      cursor:pointer;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      min-height:50px;
      padding:0 18px;
      border-radius:999px;
      font-weight:800;
      transition:transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease;
      font-family:"Manrope", sans-serif;
    }

    .btn:active{transform:translateY(1px) scale(.985)}

    .btn-primary{
      color:#fff8ec;
      background:linear-gradient(135deg, var(--gold), var(--gold-deep));
      box-shadow:0 14px 26px rgba(140,100,35,.22);
    }

    .btn-primary:hover{
      transform:translateY(-2px);
      box-shadow:0 18px 32px rgba(140,100,35,.28);
    }

    .btn-secondary{
      color:var(--ink);
      background:rgba(255,255,255,.5);
      border:1px solid rgba(78,57,31,.12);
    }

    .btn-secondary:hover{
      transform:translateY(-2px);
      background:rgba(255,255,255,.85);
    }

    .hero-side{
      padding:22px;
      display:grid;
      grid-template-rows:auto auto 1fr;
      gap:16px;
      position:relative;
      overflow:hidden;
      min-height:280px;
    }

    .seal{
      width:88px;
      height:88px;
      border-radius:50%;
      border:1px solid rgba(180,138,60,.35);
      display:grid;
      place-items:center;
      background:
        radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(236,224,196,.8));
      box-shadow: inset 0 0 0 8px rgba(180,138,60,.08);
    }

    .seal svg{width:42px;height:42px;fill:var(--gold-deep)}

    .quote{
      font-size:1rem;
      line-height:1.7;
      color:var(--muted);
      max-width:34ch;
    }

    .verse{
      font-size:.88rem;
      color:var(--gold-deep);
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    .ornament{
      position:absolute;
      right:-40px;
      bottom:-40px;
      width:180px;
      height:180px;
      opacity:.18;
      background:
        conic-gradient(from 180deg, var(--gold), transparent, var(--olive), transparent, var(--gold));
      border-radius:50%;
      filter:blur(8px);
    }

    .section{
      padding:22px 0 72px;
    }

    .section-head{
      display:grid;
      grid-template-columns:1fr;
      gap:14px;
      margin-bottom:22px;
    }

    .section-head h2{
      font-size:clamp(1.8rem, 4vw, 3.2rem);
    }

    .section-head p{
      margin:0;
      color:var(--muted);
      line-height:1.75;
      max-width:66ch;
    }

    .form-shell{
      padding:22px;
    }

    .form-grid{
      display:grid;
      grid-template-columns:1fr;
      gap:16px;
    }

    .field-group{
      display:grid;
      gap:16px;
    }

    .split{
      display:grid;
      grid-template-columns:1fr;
      gap:16px;
    }

    .field{
      display:grid;
      gap:8px;
    }

    label{
      font-size:.92rem;
      font-weight:800;
      color:#3b2d20;
    }

    input, select, textarea{
      width:100%;
      border:none;
      outline:none;
      background:var(--surface-strong);
      border:1px solid var(--line);
      border-radius:18px;
      padding:15px 16px;
      color:var(--ink);
      font:inherit;
      transition:border-color .2s ease, box-shadow .2s ease, transform .2s ease, background .2s ease;
    }

    textarea{
      min-height:130px;
      resize:vertical;
    }

    input:focus, select:focus, textarea:focus{
      border-color:rgba(180,138,60,.8);
      box-shadow:0 0 0 4px rgba(180,138,60,.12);
      background:#fffdf8;
    }

    .legend{
      font-family:"Cinzel", serif;
      font-size:1.15rem;
      margin:4px 0 2px;
      padding-bottom:10px;
      border-bottom:1px solid var(--line);
    }

    .checkline{
      display:flex;
      align-items:flex-start;
      gap:12px;
      padding:14px 14px;
      border-radius:18px;
      background:rgba(255,255,255,.42);
      border:1px solid var(--line);
    }

    .checkline input{
      width:20px;
      height:20px;
      margin-top:2px;
      accent-color:var(--gold-deep);
    }

    .muted{
      color:var(--muted);
      font-size:.92rem;
      line-height:1.6;
    }

    .actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      padding-top:8px;
    }

    .notice{
      margin-top:14px;
      padding:14px 16px;
      border-radius:16px;
      font-size:.94rem;
      display:none;
    }

    .notice.success{
      display:block;
      background:rgba(83,98,75,.12);
      color:#32402d;
      border:1px solid rgba(83,98,75,.18);
    }

    .notice.error{
      display:block;
      background:rgba(163,59,39,.10);
      color:#7a2f23;
      border:1px solid rgba(163,59,39,.18);
    }

    .info-band{
      margin-top:22px;
      display:grid;
      grid-template-columns:1fr;
      gap:14px;
    }

    .info-item{
      padding:18px;
      border-radius:20px;
      background:rgba(255,255,255,.44);
      border:1px solid var(--line);
    }

    .info-item strong{
      display:block;
      font-family:"Cinzel", serif;
      margin-bottom:8px;
    }

    footer{
      padding:24px 0 46px;
      color:var(--muted);
    }

    .footer-line{
      border-top:1px solid rgba(78,57,31,.10);
      padding-top:18px;
      display:flex;
      flex-direction:column;
      gap:10px;
      font-size:.92rem;
    }

    @media (min-width: 860px){
      .nav-links{display:flex}

      .hero-grid{
        grid-template-columns: minmax(0, 1.3fr) minmax(320px, .7fr);
      }

      .section-head{
        grid-template-columns: .8fr 1fr;
        align-items:end;
      }

      .split{
        grid-template-columns:1fr 1fr;
      }

      .info-band{
        grid-template-columns:repeat(3,1fr);
      }

      .footer-line{
        flex-direction:row;
        justify-content:space-between;
        align-items:center;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap nav">
      <a href="#cadastro" class="brand" aria-label="Ir para cadastro">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M11 2h2v7h7v2h-7v11h-2V11H4V9h7z"/>
          </svg>
        </span>
        <span class="brand-text">
          <strong>Cadastros</strong>
          <span>Ministérios Evangélicos</span>
        </span>
      </a>

      <nav class="nav-links" aria-label="Navegação principal">
        <a href="#cadastro">Cadastro</a>
        <a href="#orientacoes">Orientações</a>
        <a href="#rodape">Contato</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <article class="hero-copy reveal visible">
          <div class="eyebrow">Formulário oficial</div>
          <h1>Cadastro para coletar informações de ministérios evangélicos</h1>
          <p class="lead">
            Se você deseja criar uma página de cadastro para sua igreja ou missão, este modelo já organiza os principais dados:
            nome do ministério, responsável, contato, endereço, área de atuação e observações importantes.
            Você pode usar este formulário diretamente no site ou adaptar no WordPress com HTML personalizado.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#cadastro">Preencher cadastro</a>
            <a class="btn btn-secondary" href="#orientacoes">Como usar no WordPress</a>
          </div>
        </article>

        <aside class="hero-side reveal visible stagger-1" aria-label="Mensagem de apoio">
          <div class="seal" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 3l2.2 4.46 4.92.72-3.56 3.47.84 4.9L12 14.9l-4.4 2.3.84-4.9L4.88 8.18l4.92-.72z"/>
            </svg>
          </div>
          <p class="quote">
            Um cadastro bem estruturado ajuda a igreja a organizar informações, identificar necessidades e manter contato com ministérios, líderes e frentes missionárias.
          </p>
          <div class="verse">Organização • Missão • Comunhão</div>
          <div class="ornament" aria-hidden="true"></div>
        </aside>
      </div>
    </section>

    <section class="section" id="cadastro">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>Formulário de cadastro</h2>
          <p>
            Este formulário foi pensado para coletar dados completos de ministérios evangélicos. Ao final, os dados são organizados e podem ser enviados
            para e-mail, banco de dados ou integração com WordPress/Contact Form 7/Fluent Forms/WPForms.
          </p>
        </div>

        <div class="form-shell reveal stagger-1">
          <form id="ministerioForm" novalidate>
            <div class="form-grid">
              <div class="legend">1. Identificação do Ministério</div>

              <div class="split field-group">
                <div class="field">
                  <label for="nomeMinisterio">Nome do ministério</label>
                  <input type="text" id="nomeMinisterio" name="nomeMinisterio" placeholder="Ex.: Ministério de Louvor Ebenézer" required>
                </div>
                <div class="field">
                  <label for="tipoMinisterio">Tipo de ministério</label>
                  <select id="tipoMinisterio" name="tipoMinisterio" required>
                    <option value="">Selecione</option>
                    <option>Louvor</option>
                    <option>Missões</option>
                    <option>Intercessão</option>
                    <option>Infantil</option>
                    <option>Jovens</option>
                    <option>Casais</option>
                    <option>Ação social</option>
                    <option>Ensino</option>
                    <option>Outro</option>
                  </select>
                </div>
              </div>

              <div class="split field-group">
                <div class="field">
                  <label for="igrejaVinculada">Igreja vinculada</label>
                  <input type="text" id="igrejaVinculada" name="igrejaVinculada" placeholder="Nome da igreja ou congregação">
                </div>
                <div class="field">
                  <label for="anoFundacao">Ano de fundação</label>
                  <input type="number" id="anoFundacao" name="anoFundacao" placeholder="Ex.: 2018" min="1900" max="2100">
                </div>
              </div>

              <div class="legend">2. Responsável pelo Ministério</div>

              <div class="split field-group">
                <div class="field">
                  <label for="responsavel">Nome do responsável</label>
                  <input type="text" id="responsavel" name="responsavel" placeholder="Nome completo" required>
                </div>
                <div class="field">
                  <label for="cargo">Cargo / função</label>
                  <input type="text" id="cargo" name="cargo" placeholder="Ex.: Líder, Pastor, Coordenador">
                </div>
              </div>

              <div class="split field-group">
                <div class="field">
                  <label for="telefone">Telefone / WhatsApp</label>
                  <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" required>
                </div>
                <div class="field">
                  <label for="email">E-mail</label>
                  <input type="email" id="email" name="email" placeholder="email@ministerio.com" required>
                </div>
              </div>

              <div class="legend">3. Localização e Atuação</div>

              <div class="field">
                <label for="endereco">Endereço</label>
                <input type="text" id="endereco" name="endereco" placeholder="Rua, número, bairro, cidade, estado">
              </div>

              <div class="split field-group">
                <div class="field">
                  <label for="cidade">Cidade</label>
                  <input type="text" id="cidade" name="cidade" placeholder="Sua cidade">
                </div>
                <div class="field">
                  <label for="estado">Estado</label>
                  <input type="text" id="estado" name="estado" placeholder="UF">
                </div>
              </div>

              <div class="split field-group">
                <div class="field">
                  <label for="publico">Público atendido</label>
                  <input type="text" id="publico" name="publico" placeholder="Ex.: Jovens, famílias, crianças, comunidade">
                </div>
                <div class="field">
                  <label for="diasAtuacao">Dias ou frequência de atuação</label>
                  <input type="text" id="diasAtuacao" name="diasAtuacao" placeholder="Ex.: Quartas e domingos">
                </div>
              </div>

              <div class="legend">4. Informações complementares</div>

              <div class="field">
                <label for="descricao">Descrição do ministério</label>
                <textarea id="descricao" name="descricao" placeholder="Descreva a missão, objetivo, atividades realizadas e necessidades do ministério."></textarea>
              </div>

              <div class="field">
                <label for="redes">Redes sociais ou site</label>
                <input type="text" id="redes" name="redes" placeholder="Instagram, Facebook, YouTube, site oficial">
              </div>

              <label class="checkline" for="consentimento">
                <input type="checkbox" id="consentimento" name="consentimento" required>
                <span class="muted">
                  Autorizo o armazenamento das informações enviadas neste cadastro para fins administrativos, contato ministerial e organização interna da igreja.
                </span>
              </label>

              <div class="actions">
                <button type="submit" class="btn btn-primary">Enviar cadastro</button>
                <button type="reset" class="btn btn-secondary">Limpar formulário</button>
              </div>

              <div id="mensagem" class="notice" role="status" aria-live="polite"></div>
            </div>
          </form>
        </div>

        <div class="info-band reveal stagger-2" id="orientacoes">
          <div class="info-item">
            <strong>Como colocar no WordPress</strong>
            <div class="muted">
              No editor da página, adicione o bloco <b>HTML personalizado</b> e cole este código. Se quiser apenas o formulário, copie o trecho dentro de <b>&lt;form&gt;</b>.
            </div>
          </div>
          <div class="info-item">
            <strong>Como realmente receber os dados</strong>
            <div class="muted">
              HTML sozinho não salva informações no banco. Para funcionar de verdade, conecte com um plugin de formulário, PHP no servidor, Google Sheets ou API.
            </div>
          </div>
          <div class="info-item">
            <strong>Melhor opção prática</strong>
            <div class="muted">
              Se o site é WordPress, o mais simples é usar <b>WPForms</b>, <b>Fluent Forms</b> ou <b>Contact Form 7</b> e recriar esses campos dentro do plugin.
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer id="rodape">
    <div class="wrap footer-line">
      <span>Cadastro de Ministérios Evangélicos</span>
      <span>Modelo visual para coleta de informações no site</span>
    </div>
  </footer>

  <script>
    const observer = new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          entry.target.classList.add('visible');
        }
      });
    }, {threshold: 0.12});

    document.querySelectorAll('.reveal').forEach(el => {
      if(!el.classList.contains('visible')) observer.observe(el);
    });

    const form = document.getElementById('ministerioForm');
    const mensagem = document.getElementById('mensagem');

    form.addEventListener('submit', function(e){
      e.preventDefault();

      if(!form.checkValidity()){
        mensagem.className = 'notice error';
        mensagem.textContent = 'Por favor, preencha os campos obrigatórios antes de enviar.';
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());

      console.log('Dados do cadastro:', data);

      mensagem.className = 'notice success';
      mensagem.innerHTML = 'Cadastro preenchido com sucesso. <b>Importante:</b> para salvar de verdade no seu site, você precisa conectar este formulário a um plugin, banco de dados ou script no servidor.';
      form.reset();
    });
  </script>
</body>
</html>
